<?xml version='1.0' encoding='UTF-8'?>
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
  <Product
    Id='*'
    Name='Open CAD Studio.TW'
    UpgradeCode='c6e11f5b-5af6-4bb0-9f25-c5c5e4a86bf5'
    Manufacturer='Hakan Seven'
    Language='1033'
    Codepage='1252'
    Version='$(var.Version)'>

    <Package
      Id='*'
      Keywords='!(loc.Installer)'
      Description='!(loc.InstallerDescription)'
      Manufacturer='Hakan Seven'
      InstallerVersion='500'
      Languages='1033'
      Compressed='yes'
      InstallScope='perMachine'
      SummaryCodepage='1252' />

    <MajorUpgrade
      Schedule='afterInstallInitialize'
      DowngradeErrorMessage='!(loc.DowngradeError)' />

    <Media Id='1' Cabinet='product.cab' EmbedCab='yes' />

    <Icon Id='AppIcon.ico' SourceFile='$(var.Icon)' />
    <Property Id='ARPPRODUCTICON' Value='AppIcon.ico' />
    <Property Id='ARPHELPLINK' Value='https://github.com/tutumomo/OpenCADStudio' />
    <Property Id='ARPURLINFOABOUT' Value='https://github.com/tutumomo/OpenCADStudio' />
    <Property Id='ARPURLUPDATEINFO' Value='https://github.com/tutumomo/OpenCADStudio/releases' />
    <Property Id='ARPCONTACT' Value='Hakan Seven' />
    <Property Id='ARPCOMMENTS' Value='!(loc.ApplicationDescription)' />
    <Property Id='ARPNOREPAIR' Value='1' />

    <Directory Id='TARGETDIR' Name='SourceDir'>
      <Directory Id='ProgramFiles64Folder'>
        <Directory Id='APPLICATIONROOTDIRECTORY' Name='Open CAD Studio.TW'>

          <Component Id='MainExecutable' Guid='f8f24768-f7ed-4ffa-b559-d4b5b2946d00' Win64='yes'>
            <File
              Id='OpenCADStudioEXE'
              Name='OpenCADStudio.TW.exe'
              DiskId='1'
              Source='$(var.Source)'
              KeyPath='yes'>
              <Shortcut
                Id='StartMenuShortcut'
                Directory='ProgramMenuDir'
                Name='Open CAD Studio.TW'
                Description='!(loc.Launch)'
                WorkingDirectory='APPLICATIONROOTDIRECTORY'
                Icon='AppIcon.ico'
                IconIndex='0'
                Advertise='yes' />
            </File>
            <File Id='DwgIco' Name='dwg.ico' DiskId='1' Source='packaging\windows\dwg.ico' />
            <File Id='DxfIco' Name='dxf.ico' DiskId='1' Source='packaging\windows\dxf.ico' />
            <File
              Id='DwgThumbDll'
              Name='dwg_thumbnailer_win.dll'
              DiskId='1'
              Source='$(var.ThumbDll)' />
            <ProgId
              Id='OpenCADStudio.TW.DWG'
              Description='!(loc.DwgDrawing)'
              Icon='DwgIco'
              IconIndex='0'>
              <Extension Id='dwg' ContentType='image/vnd.dwg'>
                <Verb Id='open' Command='!(loc.Open)' TargetFile='OpenCADStudioEXE' Argument='"%1"' />
              </Extension>
            </ProgId>

            <ProgId
              Id='OpenCADStudio.TW.DXF'
              Description='!(loc.DxfDrawing)'
              Icon='DxfIco'
              IconIndex='0'>
              <Extension Id='dxf' ContentType='image/vnd.dxf'>
                <Verb Id='open' Command='!(loc.Open)' TargetFile='OpenCADStudioEXE' Argument='"%1"' />
              </Extension>
            </ProgId>
          </Component>
          <Component Id='DefaultPrograms' Guid='76b1be19-5012-4395-a505-74603a55e978' Win64='yes'>
            <RegistryValue
              Root='HKLM'
              Key='SOFTWARE\Classes\Applications\OpenCADStudio.TW.exe\DefaultIcon'
              Type='string'
              Value='[APPLICATIONROOTDIRECTORY]OpenCADStudio.TW.exe,0'
              KeyPath='yes' />
            <RegistryValue
              Root='HKLM'
              Key='SOFTWARE\Classes\Applications\OpenCADStudio.TW.exe'
              Name='FriendlyAppName'
              Type='string'
              Value='Open CAD Studio.TW' />
            <RegistryValue
              Root='HKLM'
              Key='SOFTWARE\Classes\Applications\OpenCADStudio.TW.exe\shell\open\command'
              Type='string'
              Value='"[APPLICATIONROOTDIRECTORY]OpenCADStudio.TW.exe" "%1"' />
            <RegistryValue
              Root='HKLM'
              Key='SOFTWARE\Classes\Applications\OpenCADStudio.TW.exe\SupportedTypes'
              Name='.dwg'
              Type='string'
              Value='' />
            <RegistryValue
              Root='HKLM'
              Key='SOFTWARE\Classes\Applications\OpenCADStudio.TW.exe\SupportedTypes'
              Name='.dxf'
              Type='string'
              Value='' />
            <RegistryValue
              Root='HKLM'
              Key='Software\Open CAD Studio.TW\Capabilities'
              Name='ApplicationName'
              Type='string'
              Value='Open CAD Studio.TW' />
            <RegistryValue
              Root='HKLM'
              Key='Software\Open CAD Studio.TW\Capabilities'
              Name='ApplicationDescription'
              Type='string'
              Value='!(loc.ApplicationDescription)' />
            <RegistryValue
              Root='HKLM'
              Key='Software\Open CAD Studio.TW\Capabilities\FileAssociations'
              Name='.dwg'
              Type='string'
              Value='OpenCADStudio.TW.DWG' />
            <RegistryValue
              Root='HKLM'
              Key='Software\Open CAD Studio.TW\Capabilities\FileAssociations'
              Name='.dxf'
              Type='string'
              Value='OpenCADStudio.TW.DXF' />
            <RegistryValue
              Root='HKLM'
              Key='Software\RegisteredApplications'
              Name='Open CAD Studio.TW'
              Type='string'
              Value='Software\Open CAD Studio.TW\Capabilities' />
          </Component>

        </Directory>
      </Directory>

      <Directory Id='ProgramMenuFolder'>
        <Directory Id='ProgramMenuDir' Name='Open CAD Studio.TW'>
          <Component Id='ProgramMenuDirComp' Guid='8c62f9cb-08b5-410c-82b9-7404bbea656b'>
            <RemoveFolder Id='ProgramMenuDir' On='uninstall' />
            <RegistryValue
              Root='HKCU'
              Key='Software\Open CAD Studio.TW'
              Name='installed'
              Type='integer'
              Value='1'
              KeyPath='yes' />
          </Component>
        </Directory>
      </Directory>
      <Directory Id='DesktopFolder' Name='!(loc.Desktop)'>
        <Component Id='DesktopShortcutComp' Guid='916a789d-8fe8-4cb9-a60d-5c52f3c37e75'>
          <Shortcut
            Id='DesktopShortcut'
            Name='Open CAD Studio.TW'
            Description='!(loc.Launch)'
            Target='[APPLICATIONROOTDIRECTORY]OpenCADStudio.TW.exe'
            WorkingDirectory='APPLICATIONROOTDIRECTORY'
            Icon='AppIcon.ico'
            IconIndex='0' />
          <RegistryValue
            Root='HKCU'
            Key='Software\Open CAD Studio.TW'
            Name='desktop_shortcut'
            Type='integer'
            Value='1'
            KeyPath='yes' />
        </Component>
      </Directory>
    </Directory>

    <Feature Id='Complete' Title='Open CAD Studio.TW' Level='1' Display='expand'>
      <ComponentRef Id='MainExecutable' />
      <ComponentRef Id='DefaultPrograms' />
      <ComponentRef Id='ProgramMenuDirComp' />
      <Feature
        Id='DesktopShortcut'
        Title='!(loc.DesktopShortcut)'
        Description='!(loc.DesktopShortcutDescription)'
        Level='1'
        Absent='allow'>
        <ComponentRef Id='DesktopShortcutComp' />
      </Feature>
    </Feature>
    <UIRef Id='OpenCADStudioUI' />

  </Product>
</Wix>
